{
  "name": "@akiyamka/extended-fetch",
  "version": "1.0.3",
  "description": "Tiny window.fetch JavaScript implementation over XMLHttpRequest with additional features",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akiyamka/extended-fetch"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/extended-fetch.d.ts",
  "main": "./dist/extended-fetch.cjs",
  "module": "./dist/extended-fetch.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/extended-fetch.d.ts",
        "default": "./dist/extended-fetch.js"
      },
      "require": {
        "types": "./dist/extended-fetch.d.ts",
        "default": "./dist/extended-fetch.cjs"
      }
    }
  },
  "scripts": {
    "test": "pnpm run /^test:[^:]*$/",
    "test:types": "tsc  --project \"./lib/tsconfig.json\" --noEmit",
    "test:e2e": "vitest run",
    "mock": "node ./test/mock-server.mjs",
    "dev": "vite",
    "build": "tsc --project \"./lib/tsconfig.json\"",
    "release": "pnpm test && pnpm build && pnpm publish --access public",
    "coverage": "vitest run --coverage",
    "coverage:serve": "vitest run --coverage && serve ./coverage"
  },
  "keywords": [
    "fetch",
    "xhr",
    "progress"
  ],
  "author": "akiyamka.github.io",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.12.8",
    "@vitest/browser": "^4.1.6 ",
    "@vitest/coverage-istanbul": "^: 4.1.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "webdriverio": "^9.27.1",
    "serve": "^14.2.6"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
